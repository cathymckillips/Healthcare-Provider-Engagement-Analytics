      <column caption='Provider Activation Rate' datatype='real' default-format='p0.00%' name='[Calculation_1789617956588265472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([RegisteredFlag]) &gt; 0 THEN&#13;&#10;    SUM([ActivatedFlag]) / SUM([RegisteredFlag])&#13;&#10;END' />
      </column>
      <column caption='Monthly Retention Rate' datatype='real' name='[Calculation_1789617956661710849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([PriorActiveFlag]) &gt; 0 THEN&#13;&#10;    SUM([RetainedFlag]) / SUM([PriorActiveFlag])&#13;&#10;END' />
