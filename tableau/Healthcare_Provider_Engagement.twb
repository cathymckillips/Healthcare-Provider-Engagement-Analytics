            <column-instance column='[MonthStart]' derivation='MY' name='[my:MonthStart:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1789617956661710849]' derivation='User' name='[usr:Calculation_1789617956661710849:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1d265gx149nvvg1agqtuk1gyvv7i].[my:MonthStart:ok]'>
